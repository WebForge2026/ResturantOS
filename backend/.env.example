APP_NAME="NOAR RestaurantOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bg_BG
APP_TIMEZONE=Europe/Sofia

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noar
DB_USERNAME=noar
DB_PASSWORD=noar_local

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Realtime: set to "reverb" and run `php artisan reverb:start`. "log" disables websockets
# (clients then fall back to polling automatically).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=noar-local
REVERB_APP_KEY=noar-local-key
REVERB_APP_SECRET=noar-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# LOCAL DEMO ONLY: allows the QR app to resolve ?table=7 to the table's QR token.
# Must be false in production (the endpoint is also refused unless APP_ENV=local).
NOAR_DEMO_TABLE_LOOKUP=true
# Password for seeded demo accounts (local only). Change it before seeding if you like.
NOAR_DEMO_PASSWORD=noar-demo-2026

MAIL_MAILER=log
